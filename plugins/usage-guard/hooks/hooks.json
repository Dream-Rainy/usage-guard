{
  "description": "Usage-aware lifecycle guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Loading Usage Guard state",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Preparing usage check",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Checking Usage Guard policy",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Updating Usage Guard policy",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Preserving Usage Guard state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Restoring Usage Guard state"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Passing Usage Guard policy to subagent",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 15,
            "statusMessage": "Finalizing Usage Guard check"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/usage-guard.js\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\usage-guard.js\"",
            "timeout": 3,
            "statusMessage": "Cleaning Usage Guard state"
          }
        ]
      }
    ]
  }
}
